generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                  String    @unique
  password               String
  name                   String?
  username               String?
  emailConfirmationToken String?   @map("email_confirmation_token")
  isEmailConfirmed       Boolean   @default(false) @map("is_email_confirmed")
  status                 Boolean   @default(false)
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime? @default(now()) @updatedAt @map("updated_at")
  roleId                 String    @map("role_id") @db.Uuid
  role                   Role      @relation(fields: [roleId], references: [id])

  @@map("users")
}

model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  privileges  Json?
  description String?
  userType    UserRole @map("user_type")
  User        User[]

  @@map("roles")
}

enum UserRole {
  ADMIN
  CUSTOMER
}

model Entity {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String    @db.VarChar(500)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @default(now()) @updatedAt @map("updated_at")
  items     Item[]    @relation("EntityItems") // One-to-many relation

  @@map("entity")
}

model Item {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String           @unique @db.VarChar(500)
  description    String
  roomInitial    String?          @unique @map("room_initial") @db.VarChar(250)
  parentRoomId   String?          @map("parent_room_id") @db.Uuid
  status         Boolean          @default(true)
  entity         Entity           @relation("EntityItems", fields: [entityId], references: [id])
  entityId       String           @map("entity_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime?        @default(now()) @updatedAt @map("updated_at")
  uploadRelation UploadRelation[]

  @@map("item")
}

enum TableName {
  ITEM
}

model Upload {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  file           String           @db.VarChar(500)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime?        @default(now()) @updatedAt @map("updated_at")
  UploadRelation UploadRelation[]

  @@map("upload")
}

model UploadRelation {
  id            String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  upload        Upload @relation(fields: [imageUploadId], references: [id], onDelete: Cascade)
  imageUploadId String @map("image_upload_id") @db.Uuid

  table   TableName
  item    Item      @relation(fields: [tableId], references: [id], onDelete: Cascade)
  tableId String    @map("table_id") @db.Uuid

  @@map("uploadRelation")
}
