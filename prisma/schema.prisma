generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ENUMS
enum UserRole {
  ADMIN
  CUSTOMER
}

enum BookingStatus {
  BOOKED
  CANCELLED
  RESERVED
  CHECKEDIN
  CHECKDOUT
  OVERDUE
}

// MASTER TABLES
model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @db.VarChar(500)
  privileges  Json?
  description String?
  userType    UserRole @map("user_type")
  User        User[]

  @@map("roles")
}

model User {
  id                     String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                  String                 @unique
  name                   String?                @db.VarChar(500)
  username               String?                @db.VarChar(500)
  contactNumber          String?                @unique @map("contact_number")
  password               String
  emailConfirmationToken String?                @map("email_confirmation_token")
  isEmailConfirmed       Boolean                @default(false) @map("is_email_confirmed")
  role                   Role                   @relation(fields: [roleId], references: [id])
  roleId                 String                 @map("role_id") @db.Uuid
  createdAt              DateTime               @default(now()) @map("created_at")
  updatedAt              DateTime?              @default(now()) @updatedAt @map("updated_at")
  deletedAt              DateTime?              @map("deleted_at")
  BookedBy               Booking[]              @relation("booking_booked_by")
  bookingHistoryBookedBy BookingStatusHistory[] @relation("booking_history_booked_by")
  UploadRelation         UploadRelation[]
  Notification           Notification[]

  @@map("users")
}

model Amenities {
  id                              String                            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                            String                            @unique
  description                     String?
  createdAt                       DateTime                          @default(now()) @map("created_at")
  updatedAt                       DateTime?                         @default(now()) @updatedAt @map("updated_at")
  deletedAt                       DateTime?                         @map("deleted_at")
  UploadRelation                  UploadRelation[]
  BranchAmenitiesRelation         BranchAmenitiesRelation[]
  BranchRoomTypeAmenitiesRelation BranchRoomTypeAmenitiesRelation[]

  @@map("amenities")
}

model RoomType {
  id                     String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                   String                   @unique @db.VarChar(500)
  description            String?
  roomInitial            String                   @map("room_initial") @db.VarChar(255)
  createdAt              DateTime                 @default(now()) @map("created_at")
  updatedAt              DateTime?                @default(now()) @updatedAt @map("updated_at")
  deletedAt              DateTime?                @map("deleted_at")
  BranchRoomTypeRelation BranchRoomTypeRelation[]

  @@map("roomType")
}

model Branch {
  id                      String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                    String                    @unique
  address                 String
  contactNumber           String                    @unique @map("contact_number")
  city                    String                    @db.VarChar(255)
  areaPincode             String                    @map("area_pincode")
  location                String                    @db.VarChar(500)
  description             String?
  createdAt               DateTime                  @default(now()) @map("created_at")
  updatedAt               DateTime?                 @default(now()) @updatedAt @map("updated_at")
  deletedAt               DateTime?                 @map("deleted_at")
  UploadRelation          UploadRelation[]
  BranchRoomTypeRelation  BranchRoomTypeRelation[]
  BranchAmenitiesRelation BranchAmenitiesRelation[]
  Booking                 Booking[]

  @@map("branch")
}

model Room {
  id               String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roomName         String                 @db.VarChar(255)
  branchRoomType   BranchRoomTypeRelation @relation(fields: [branchRoomTypeId], references: [id], onDelete: Cascade)
  branchRoomTypeId String                 @map("branch_room_type_id") @db.Uuid
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime?              @default(now()) @updatedAt @map("updated_at")
  deletedAt        DateTime?              @map("deleted_at")
  Booking          Booking[]

  @@map("room")
}

model Booking {
  id                       String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookedBy                 User?                  @relation("booking_booked_by", fields: [bookedById], references: [id])
  bookedById               String?                @map("booked_by_id") @db.Uuid
  fullName                 String                 @map("full_name")
  contactNumber            String                 @map("contact_number")
  source                   String                 @db.VarChar(255)
  finalPrice               Decimal                @map("final_price") @db.Decimal(10, 2)
  checkInDate              DateTime               @map("check_in_date")
  checkOutDate             DateTime               @map("check_out_date")
  description              String?
  bookingStatus            BookingStatus
  upload                   Upload?                @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  uploadId                 String?                @map("upload_id") @db.Uuid
  BranchRoomTypeRelation   BranchRoomTypeRelation @relation(fields: [branchRoomTypeRelationId], references: [id])
  branchRoomTypeRelationId String                 @map("branch_room_type_relation_id") @db.Uuid
  branch                   Branch                 @relation(fields: [branchId], references: [id], onDelete: Cascade)
  branchId                 String                 @map("branch_id") @db.Uuid
  room                     Room                   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomId                   String                 @map("room_id") @db.Uuid
  createdAt                DateTime               @default(now()) @map("created_at")
  updatedAt                DateTime?              @default(now()) @updatedAt @map("updated_at")
  deletedAt                DateTime?              @map("deleted_at")
  BookingStatusHistory     BookingStatusHistory[]
  Notification             Notification[]

  @@map("booking")
}

model Upload {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  file           String           @db.VarChar(500)
  createdAt      DateTime         @default(now()) @map("created_at")
  UploadRelation UploadRelation[]
  Booking        Booking[]

  @@map("upload")
}

model BookingStatusHistory {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingStatus BookingStatus
  booking       Booking       @relation(fields: [bookingId], references: [id])
  bookingId     String        @map("booking_id") @db.Uuid
  bookedBy      User?         @relation("booking_history_booked_by", fields: [bookedById], references: [id])
  bookedById    String?       @map("booked_by_id") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime?     @default(now()) @updatedAt @map("updated_at")

  @@map("bookingStatusHistory")
}

// RELATIONAL TABLES
model UploadRelation {
  id               String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  upload           Upload                  @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  uploadId         String                  @map("upload_id") @db.Uuid
  amenities        Amenities?              @relation(fields: [amenitiesId], references: [id], onDelete: Cascade)
  amenitiesId      String?                 @map("amenities_id") @db.Uuid
  branch           Branch?                 @relation(fields: [branchId], references: [id], onDelete: Cascade)
  branchId         String?                 @map("branch_id") @db.Uuid
  branchRoomType   BranchRoomTypeRelation? @relation(fields: [branchRoomTypeId], references: [id], onDelete: Cascade)
  branchRoomTypeId String?                 @map("branch_room_type_id") @db.Uuid
  createdAt        DateTime                @default(now()) @map("created_at")
  User             User?                   @relation(fields: [userId], references: [id])
  userId           String?                 @map("user_id") @db.Uuid

  @@map("uploadRelation")
}

model BranchRoomTypeRelation {
  id                              String                            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branch                          Branch                            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  branchId                        String                            @map("branch_id") @db.Uuid
  roomType                        RoomType                          @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  roomTypeId                      String                            @map("room_type_id") @db.Uuid
  setPrice                        Decimal                           @map("set_price") @db.Decimal(10, 2)
  offerPrice                      Decimal                           @map("offer_price") @db.Decimal(10, 2)
  description                     String?
  createdAt                       DateTime                          @default(now()) @map("created_at")
  updatedAt                       DateTime?                         @default(now()) @updatedAt @map("updated_at")
  deletedAt                       DateTime?                         @map("deleted_at")
  Room                            Room[]
  UploadRelation                  UploadRelation[]
  BranchRoomTypeAmenitiesRelation BranchRoomTypeAmenitiesRelation[]
  Booking                         Booking[]

  @@map("branchRoomTypeRelation")
}

model BranchRoomTypeAmenitiesRelation {
  id               String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  amenities        Amenities?             @relation(fields: [amenitiesId], references: [id])
  amenitiesId      String?                @map("amenities_id") @db.Uuid
  branchRoomType   BranchRoomTypeRelation @relation(fields: [branchRoomTypeId], references: [id], onDelete: Cascade)
  branchRoomTypeId String                 @map("branch_room_type_id") @db.Uuid
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime?              @default(now()) @updatedAt @map("updated_at")

  @@map("branchRoomTypeAmenitiesRelation")
}

model BranchAmenitiesRelation {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  amenities   Amenities? @relation(fields: [amenitiesId], references: [id])
  amenitiesId String?    @map("amenities_id") @db.Uuid
  branch      Branch?    @relation(fields: [branchId], references: [id])
  branchId    String?    @map("branch_id") @db.Uuid
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime?  @default(now()) @updatedAt @map("updated_at")

  @@map("branchAmenitiesRelation")
}

model Notification {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  User           User      @relation(fields: [notifiedUserId], references: [id])
  notifiedUserId String    @map("notified_user_id") @db.Uuid
  booking        Booking   @relation(fields: [bookingId], references: [id])
  bookingId      String    @map("booking_id") @db.Uuid
  description    String?
  customerNumber String?
  customerEmail  String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime? @default(now()) @updatedAt @map("updated_at")

  @@map("notification")
}
